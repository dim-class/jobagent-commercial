# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# --- OpenAI (backend only, never exposed to the frontend) ---
OPENAI_API_KEY=sk-your-key-here
# Any OpenAI-compatible endpoint. Leave empty for OpenAI itself; set it to
# https://api.deepseek.com/v1 (or Moonshot, 通义, ...) to use another provider.
# All four of these can also be set from the app: 设置 -> AI 接口.
OPENAI_BASE_URL=
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_SMART=gpt-5.6-terra

# --- storage ---
DATABASE_URL=sqlite:///./data/jobagent.db

# --- behaviour ---
MAX_ANALYSES_PER_RUN=50
AUTO_APPLY=false

# --- browser capture (v0.2) ---
# The capture browser is ALWAYS visible; there is no headless option for it.
# Persistent profile so you only log in once. Never reuses your daily browser.
# BROWSER_PROFILE_DIR=data/browser_profiles/boss
# BROWSER_SUPPORTED_HOSTS=zhipin.com
# auto | chromium | msedge | chrome
# BROWSER_CHANNEL=auto

# --- optional: local server binding (defaults shown) ---
# APP_HOST=127.0.0.1
# APP_PORT=8000
# LOG_LEVEL=INFO

# --- career analytics (v0.6) ---
# All deterministic: these only tune how cautious the analytics page is.
# Nothing here causes an OpenAI call.
# An application is only counted as "no response" after this many days.
# RESPONSE_MATURITY_DAYS=7
# INTERVIEW_MATURITY_DAYS=14
# Below this sample size every cohort is labelled 样本不足.
# ANALYTICS_MIN_SAMPLE=5
# Below this sample size no actionable strategy proposal is produced.
# ANALYTICS_RECOMMEND_SAMPLE=8
# Below this share of weighted coverage, an offer comparison names no winner.
# OFFER_DECISION_MIN_COVERAGE=0.7

# --- reporting ---
# "Today" is a local concept; daily metrics convert UTC to this zone.
# REPORT_TIMEZONE=Asia/Tokyo
