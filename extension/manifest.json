{
  "manifest_version": 3,
  "name": "JobAgent BOSS Detector",
  "version": "0.1.20",
  "description": "通过本地 JobAgent 控制台显式启动有限 BOSS 搜索采集并支持逐岗位确认投递。不批量投递、不扫描沟通、不后台、不自动重试或跟进。",

  "permissions": ["activeTab", "scripting", "storage"],

  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*", "https://www.zhipin.com/*", "http://127.0.0.1:5173/*", "http://localhost:5173/*"],

  "background": {
    "service_worker": "dist/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": [
        "dist/boss/selectors.js",
        "dist/boss/extract.js",
        "dist/content.js",
        "dist/overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:5173/*", "http://localhost:5173/*", "http://127.0.0.1:8000/*", "http://localhost:8000/*"],
      "js": ["dist/console-bridge.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "JobAgent BOSS Detector"
  }
}
